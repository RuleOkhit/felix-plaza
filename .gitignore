# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# raw logo download packages (.ai/.eps/.cdr working files).
# The web-ready copies live in public/images/logos/ and are committed.
/Logos/

# raw hero photography + the logo artwork PDF (~24MB of originals).
# The web-ready copies live in public/images/ and are committed.
/Hero Images/

# raw store-page materials (banners, gallery shots, Info.txt per store).
# The web-ready copies live in public/images/stores/ and are committed.
/Stores/

# Claude Code machine-specific settings
.claude/settings.local.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
